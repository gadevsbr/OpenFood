{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenFood DiningRequest — POST /api/dining-tabs",
  "description": "Session cookie + X-OpenFood:1 + X-Store-ID optional. Idempotency-Key 8..128 bytes required. Successful mutation returns {id: integer}. Money is integer BRL cents. Same key and payload replay the original result; altered payload yields 409 idempotency_conflict.",
  "type": "object",
  "required": [
    "action"
  ],
  "properties": {
    "action": {
      "enum": [
        "open",
        "add",
        "close",
        "cancel"
      ]
    },
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "table_id": {
      "type": "integer",
      "minimum": 0
    },
    "label": {
      "type": "string",
      "maxLength": 80
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "expected_remaining_cents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "note": {
      "type": "string",
      "maxLength": 1000
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "order-request.schema.json#/$defs/item"
      }
    },
    "payments": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "method",
          "amount_cents"
        ],
        "properties": {
          "method": {
            "enum": [
              "cash",
              "card",
              "pix_manual"
            ]
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000000
          },
          "tendered_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          }
        },
        "additionalProperties": false
      }
    },
    "customer_id": {
      "type": "integer",
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "open"
          }
        }
      },
      "then": {
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "minLength": 1
          }
        }
      },
      "else": {
        "required": [
          "id",
          "expected_version"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "add"
          }
        }
      },
      "then": {
        "required": [
          "items",
          "expected_remaining_cents"
        ],
        "properties": {
          "items": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "close"
          }
        }
      },
      "then": {
        "required": [
          "payments",
          "expected_remaining_cents"
        ]
      }
    }
  ],
  "additionalProperties": false
}
